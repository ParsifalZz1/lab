# Application
MODELFLOW_ENV=development
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///./model_flow.db

# Registry and execution defaults
REGISTRY_LEASE_SECONDS=30
REGISTRY_HEARTBEAT_SECONDS=10
EXECUTOR_MAX_CONCURRENCY=8
EVENT_RETENTION_HOURS=168

# Optional model integration. Keep credentials empty in local and CI environments.
BRAIN_API_BASE_URL=
BRAIN_API_KEY=
WORKER_API_KEY=
